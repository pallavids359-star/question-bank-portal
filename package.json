{
  "name": "question-bank-backend-supabase",
  "version": "1.0.0",
  "description": "Express + Supabase backend for the Question Bank Portal",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1",
    "test:security": "node --test test/security/authentication.test.js test/security/question-workflow.test.js",
    "test:regression": "node --test test/regression/auth-view-state.test.js test/regression/content-renderer.test.js test/regression/dashboard-view.test.js test/regression/user-role.test.js",
    "lint": "node --check server.js && node scripts/check-js.js",
    "typecheck": "node scripts/check-js.js",
    "build": "node scripts/check-js.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
